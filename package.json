{
  "name": "nedenmis-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Nedenmiş kanalı için yapay zekâ destekli Türkçe dikey video stüdyosu",
  "author": "Nedenmiş",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs && npm run typecheck",
    "build:main": "node scripts/build.mjs --main-only",
    "build:renderer": "vite build",
    "prestart": "node scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "start": "electron .",
    "preview": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint . --max-warnings=0",
    "pretest": "node scripts/prepare-node-native.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "pretest:chatterbox": "node scripts/prepare-node-native.mjs",
    "test:chatterbox": "vitest run tests/integration/chatterbox.e2e.test.ts",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "smoke:dev": "node scripts/electron-smoke.mjs --dev",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:zip": "node scripts/package-zip.mjs",
    "pack:portable": "node scripts/package-portable.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "@fontsource/inter": "^5.2.5",
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.3"
  }
}
